# --- Instagram Login API ---
IG_ACCESS_TOKEN=
IG_USER_ID=
GRAPH_API_VERSION=v26.0
IG_API_MODE=instagram_login

# Instagram Login'de yerel Windows videosu Meta tarafından görülemez.
# tmpfiles seçeneği videoyu geçici HTTPS adrese yükler.
PUBLIC_UPLOAD_MODE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# --- Çalışma ayarları ---
DATA_DIR=./data
MAX_POSTS_PER_RUN=3
DEFAULT_CAPTION=Yeni reel! Kaynak: {source_url}
COOKIES_FILE=
STATUS_POLL_SECONDS=60
STATUS_POLL_ATTEMPTS=5

CONTENT_RIGHTS_CONFIRMED=false
